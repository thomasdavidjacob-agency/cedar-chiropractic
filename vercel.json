{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/about-us(/)?", "destination": "/about.html", "permanent": true },
    { "source": "/our-chiropractic-team(/)?", "destination": "/about.html", "permanent": true },
    { "source": "/new-patients(/)?", "destination": "/new-patients.html", "permanent": true },
    { "source": "/online-forms(/)?", "destination": "/new-patients.html", "permanent": true },
    { "source": "/chiropractic-services(/)?", "destination": "/services.html", "permanent": true },
    { "source": "/services(/)?", "destination": "/services.html", "permanent": true },
    { "source": "/contact(/)?", "destination": "/contact.html", "permanent": true },
    { "source": "/about(/)?", "destination": "/about.html", "permanent": true },
    { "source": "/blog(/)?", "destination": "/blog.html", "permanent": true },
    { "source": "/sitemap(/)?", "destination": "/sitemap.xml", "permanent": true },
    { "source": "/Accessibility(/)?", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml" }]
    }
  ]
}
